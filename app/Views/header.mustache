<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nested Forum</title>
  <style>
    body { margin: 0; font: 16px/1.5 system-ui, sans-serif; color: #1f2328; background: #f6f8fa; }
    main { max-width: 760px; margin: 0 auto; padding: 1rem; }
    a, .link { color: #0b5cad; }
    header { display: flex; justify-content: space-between; align-items: center; padding: .75rem 1rem;
             background: #fff; border-bottom: 1px solid #d0d7de; }
    header nav { display: flex; gap: 1rem; align-items: center; }
    button { font: inherit; padding: .4rem .9rem; border: 0; border-radius: 6px; background: #0b5cad; color: #fff; cursor: pointer; }
    button.link { background: none; padding: 0; text-decoration: underline; }
    textarea, input { width: 100%; box-sizing: border-box; font: inherit; padding: .5rem; border: 1px solid #d0d7de; border-radius: 6px; }
    form.stack { display: grid; gap: .75rem; max-width: 360px; }
    .meta { color: #57606a; font-size: .875rem; margin: 0; }
    .flash, .error { padding: .5rem .75rem; border-radius: 6px; background: #fff8c5; border: 1px solid #d4a72c; }
    .error { background: #ffebe9; border-color: #cf222e; }
    .topic, .comment { background: #fff; border: 1px solid #d0d7de; border-radius: 8px; padding: .75rem; margin: .5rem 0; }
    .thread { list-style: none; padding: 0; }
    .comment { display: flex; gap: .75rem; border-left: 3px solid #0b5cad; }
    .comment .body { margin: .25rem 0; white-space: pre-line; overflow-wrap: anywhere; }
    .comment > div { flex: 1; }
    details form { display: grid; gap: .5rem; margin-top: .5rem; }
    /* indentation stops at depth 8, the "Depth N" label keeps the real number */
    .indent-1 { margin-left: 1.5rem; } .indent-2 { margin-left: 3rem; } .indent-3 { margin-left: 4.5rem; }
    .indent-4 { margin-left: 6rem; } .indent-5 { margin-left: 7.5rem; } .indent-6 { margin-left: 9rem; }
    .indent-7 { margin-left: 10.5rem; } .indent-8 { margin-left: 12rem; }
  </style>
</head>
<body>
<header>
  <a href="/"><strong>Nested Forum</strong></a>
  <nav>
    {{#me}}
      <span>Signed in as <strong>{{username}}</strong></span>
      <form method="post" action="/logout">
        <input type="hidden" name="csrf" value="{{csrf}}">
        <button type="submit" class="link">Log out</button>
      </form>
    {{/me}}
    {{^me}}
      <a href="/login">Log in</a>
      <a href="/register">Register</a>
    {{/me}}
  </nav>
</header>
<main>
{{#flash}}<p class="flash" role="status">{{flash}}</p>{{/flash}}
