{{> header}}
<h1>Register</h1>
{{#error}}<p class="error" role="alert">{{error}}</p>{{/error}}
<form method="post" action="/register" class="stack">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <label>Username <input name="username" value="{{username}}" pattern="[A-Za-z0-9_]{3,30}" autocomplete="username" required></label>
  <label>Email <input type="email" name="email" value="{{email}}" autocomplete="email" required></label>
  <label>Password <input type="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required></label>
  <button type="submit">Create account</button>
</form>
<p>Already registered? <a href="/login">Log in</a></p>
{{> footer}}
