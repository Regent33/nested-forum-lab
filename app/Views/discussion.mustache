{{> header}}
{{#discussion}}
<article class="topic">
  <h1>{{title}}</h1>
  <p class="meta">Started by {{author}} · {{created_at}} UTC</p>
  <p>{{body}}</p>
</article>

<h2>{{count}} comments</h2>
<ol class="thread">
  {{#comments}}
  <li id="c{{id}}" class="comment indent-{{indent}}">
    <!-- default avatar -->
    <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="#c9d1d9"/><circle cx="16" cy="12" r="6" fill="#fff"/><path d="M5 27c2-6 7-8 11-8s9 2 11 8" fill="#fff"/></svg>
    <div>
      <p class="meta"><strong>{{author}}</strong> · {{created_at}} UTC · Depth {{depth}}</p>
      <p class="body">{{body}}</p>
      {{#me}}
      <details>
        <summary class="link">Reply</summary>
        <form method="post" action="/discussions/{{discussion.id}}/comments">
          <input type="hidden" name="csrf" value="{{csrf}}">
          <input type="hidden" name="parent_id" value="{{id}}">
          <textarea name="body" rows="3" maxlength="2000" required aria-label="Reply to {{author}}"></textarea>
          <button type="submit">Post reply</button>
        </form>
      </details>
      {{/me}}
    </div>
  </li>
  {{/comments}}
</ol>

{{#me}}
<h2>Add a top-level comment</h2>
<form method="post" action="/discussions/{{id}}/comments" class="stack">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <textarea name="body" rows="4" maxlength="2000" required aria-label="Comment"></textarea>
  <button type="submit">Post comment</button>
</form>
{{/me}}
{{^me}}
<p class="meta"><a href="/login">Log in</a> or <a href="/register">register</a> to reply.</p>
{{/me}}
{{/discussion}}
{{> footer}}
